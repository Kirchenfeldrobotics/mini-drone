{
    "name": "ESP-IDF",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "DOCKER_TAG": "v5.5.4"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "idf.espIdfPath": "/opt/esp/idf",
                "idf.toolsPath": "/opt/esp",
                "idf.gitPath": "/usr/bin/git",
                "idf.showOnboardingOnInit": false
            },
            "extensions": [
                "espressif.esp-idf-extension",
                "ms-vscode.cpptools"
            ]
        }
    },
    "runArgs": ["--privileged"]
}